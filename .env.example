# BizInsight AI settings.
# 1. Copy this file to a new file named `.env` (in the same folder).
# 2. Paste your real key below. `.env` is git-ignored, so it never goes to GitHub.
# 3. Restart the app.
OPENAI_API_KEY=sk-your-key-here

# Optional: which OpenAI model to use (must be available to your account).
OPENAI_MODEL=gpt-5-mini

# Optional: AI requests per day across all users of a running app (default 2).
# AI_DAILY_LIMIT=2
