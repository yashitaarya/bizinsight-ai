# Only needed when hosting on Streamlit Community Cloud (paste these into the app's Secrets settings).
# Locally, use the .env file instead. Never commit a real secrets.toml — it is git-ignored.
OPENAI_API_KEY = "sk-your-key-here"
OPENAI_MODEL = "gpt-5-mini"
# Optional: AI requests per day across all visitors (protects your credit on a public app).
AI_DAILY_LIMIT = "2"
